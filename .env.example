# MongoDB Atlas connection string (create a free cluster at https://www.mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ewala-eternal?retryWrites=true&w=majority

# Port the API server listens on
PORT=5000

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:5173

# Password to log into the /admin page (pick your own strong password)
ADMIN_PASSWORD=ewala@123

# Random secret used to sign admin login sessions — any long random string
JWT_SECRET=e-wala-eternal-jwt-string
